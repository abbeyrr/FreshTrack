<Window x:Class="FreshTrack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreshTrack · Household Food Manager"
        Width="1260" Height="820" MinWidth="940" MinHeight="640"
        Background="#F3F7F4" Foreground="#19342B" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#19342B"/>
        <SolidColorBrush x:Key="Muted" Color="#64786F"/>
        <SolidColorBrush x:Key="Accent" Color="#218563"/>
        <SolidColorBrush x:Key="Line" Color="#DFE9E2"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="29"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E7F1EA"/>
            <Setter Property="Foreground" Value="#1A674F"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FBECE8"/>
            <Setter Property="Foreground" Value="#B44E3E"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="BorderBrush" Value="#BDD0C1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FCFEFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="BorderBrush" Value="#CCD9D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="BorderBrush" Value="#CCD9D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9F0EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FBF8"/>
            <Setter Property="RowHeight" Value="37"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EFF5F0"/>
                        <Setter Property="Foreground" Value="#476457"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#60766B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EAF3EC"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#143E32" Padding="26,17">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2DA475" CornerRadius="10" Width="42" Height="42" Margin="0,0,13,0">
                        <TextBlock Text="F" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="FreshTrack" Foreground="White" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="Make the most of what you have" Foreground="#BED8C8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#245B48" CornerRadius="20" Padding="14,8" VerticalAlignment="Center">
                    <TextBlock Text="HOUSEHOLD FOOD MANAGER" Foreground="#D7ECDE" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E8F2EA" BorderBrush="#D8E7DC" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeedbackText" Text="Ready" Foreground="#285A43" FontSize="12" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Margin="24,10,24,14" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Inventory">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR PANTRY" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Inventory" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="InventorySummary" Text="Loading food records…" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,9,0">
                                <TextBlock Text="SEARCH FOODS" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SearchBox" Width="220" Height="37" ToolTip="Search food name or category" TextChanged="SearchBox_TextChanged"/>
                            </StackPanel>
                            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Click="Refresh_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="440"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Food records" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Select a row to edit or record usage" Style="{StaticResource Hint}" Margin="14,4,0,0"/>
                                </DockPanel>
                                <DataGrid x:Name="FoodGrid" Grid.Row="1" SelectionChanged="FoodGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="120"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="90"/>
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                                        <DataGridTextColumn Header="Purchased" Binding="{Binding PurchasedOn, StringFormat=d}" Width="*" MinWidth="90"/>
                                        <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresOn, StringFormat=d}" Width="*" MinWidth="90"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" MinWidth="80"/>
                                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" MinWidth="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Food details" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Add a new item or select one from the table to edit." Style="{StaticResource Hint}" Margin="0,4,0,2"/>
                                    <TextBlock Text="FOOD NAME" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FoodName"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FoodCategoryBox"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="QTY" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FoodQuantity"/></StackPanel>
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="PURCHASE DATE" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="PurchaseDate"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="EXPIRY DATE" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="ExpiryDate"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FoodNotes"/>
                                    <Button Content="Save food" Margin="0,18,0,0" Click="SaveFood_Click"/>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Content="Clear form" Style="{StaticResource SecondaryButton}" Click="ClearFood_Click"/>
                                        <Button Grid.Column="2" Content="Delete selected" Style="{StaticResource DangerButton}" Click="DeleteFood_Click"/>
                                    </Grid>
                                    <Border Background="#F1F7F2" CornerRadius="9" Padding="12" Margin="0,20,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Record food use" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                            <TextBlock x:Name="RecordHelp" Text="Choose an in-stock row, then record the quantity used or wasted." Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="QUANTITY" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RecordQuantity" Text="1"/>
                                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button x:Name="UsedButton" Content="Used" Style="{StaticResource SecondaryButton}" Click="Used_Click"/>
                                                <Button x:Name="WastedButton" Grid.Column="2" Content="Wasted" Style="{StaticResource DangerButton}" Click="Wasted_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Expiry dashboard">
                <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="WHAT NEEDS ATTENTION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Expiry &amp; risk dashboard" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Expired uses dates; high risk uses the calibrated synthetic model. Date status stays visible below." Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><TextBlock Text="SHOW STATUS" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><ComboBox x:Name="ExpiryFilter" Width="180" SelectionChanged="ExpiryFilter_SelectionChanged"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Background="#FFF2EF" BorderBrush="#F5D6CF"><StackPanel><TextBlock Text="EXPIRED" Style="{StaticResource Eyebrow}" Foreground="#B85444"/><TextBlock x:Name="ExpiredCount" Text="0" Style="{StaticResource MetricValue}" Foreground="#B85444"/><TextBlock Text="Past the expiry date" Style="{StaticResource Hint}"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Background="#FFF8E9" BorderBrush="#F1E5BD"><StackPanel><TextBlock Text="HIGH WASTE RISK" Style="{StaticResource Eyebrow}" Foreground="#A87813"/><TextBlock x:Name="HighRiskCount" Text="0" Style="{StaticResource MetricValue}" Foreground="#A87813"/><TextBlock Text="At or above the model threshold" Style="{StaticResource Hint}"/></StackPanel></Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}" Background="#EAF6EE" BorderBrush="#CCEAD5"><StackPanel><TextBlock Text="LOWER MODEL RISK" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="LowerRiskCount" Text="0" Style="{StaticResource MetricValue}"/><TextBlock Text="Below the model threshold" Style="{StaticResource Hint}"/></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12"><TextBlock Text="Food attention timeline" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="ExpirySummary" Style="{StaticResource Hint}" Margin="16,4,0,0"/></DockPanel>
                            <DataGrid x:Name="ExpiryGrid" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Status}" Width="*" MinWidth="110"/>
                                    <DataGridTextColumn Header="Food" Binding="{Binding Name}" Width="2*" MinWidth="150"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="110"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiresOn, StringFormat=d}" Width="*" MinWidth="110"/>
                                    <DataGridTextColumn Header="Days left" Binding="{Binding DaysLeft}" Width="*" MinWidth="100"/>
                                    <DataGridTextColumn Header="Date status" Binding="{Binding DateStatus}" Width="*" MinWidth="110"/>
                                    <DataGridTextColumn Header="Simulated waste risk" Binding="{Binding SimulatedRisk}" Width="*" MinWidth="145"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Shopping list">
                <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16"><TextBlock Text="PLAN THE NEXT SHOP" Style="{StaticResource Eyebrow}"/><TextBlock Text="Shopping list" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="ShoppingSummary" Text="Loading shopping items…" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="440"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Planned purchases" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <DataGrid x:Name="ShoppingGrid" Grid.Row="1" SelectionChanged="ShoppingGrid_SelectionChanged"><DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*" MinWidth="150"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="110"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTemplateColumn Header="Purchased" Width="*" MinWidth="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsPurchased, Mode=OneWay}"
                                                      Click="PurchasedCheckBox_Click"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Margin="10,0,0,0" Cursor="Hand"
                                                      ToolTip="Mark as purchased; then use the button on the right to add it to inventory">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPurchased}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Purchase date" Binding="{Binding PurchasedOn, StringFormat=d}" Width="*" MinWidth="120"/>
                            </DataGrid.Columns></DataGrid>
                        </Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="Add to shopping list" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Plan what you need before your next shop." Style="{StaticResource Hint}" Margin="0,4,0,3"/>
                            <TextBlock Text="ITEM NAME" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ShoppingName"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ShoppingCategoryBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="QTY" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ShoppingQuantity" Text="1"/></StackPanel>
                            </Grid>
                            <Button Content="Add to list" Margin="0,13,0,0" Click="AddShopping_Click"/>
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14"/>
                            <TextBlock Text="After shopping" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ShoppingStepText" Text="Tick Purchased, select the row, then choose an expiry date." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            <TextBlock Text="EXPIRY DATE" Style="{StaticResource FieldLabel}" Margin="0,8,0,5"/><DatePicker x:Name="ShoppingExpiryDate"/>
                            <Button x:Name="TransferShoppingButton" Content="Add selected purchase to inventory" Margin="0,13,0,0" Click="PurchaseShopping_Click"/>
                            <Button Content="Delete selected" Style="{StaticResource DangerButton}" Margin="0,6,0,0" Click="DeleteShopping_Click"/>
                        </StackPanel></ScrollViewer></Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Reports">
                <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="SEE THE BIG PICTURE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Reports &amp; insights" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="ReportSummary" Text="Loading reports…" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
                        <Button Grid.Column="1" Content="Refresh reports" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Click="Refresh_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="IN STOCK" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="StockCount" Text="0" Style="{StaticResource MetricValue}"/><TextBlock Text="Units available now" Style="{StaticResource Hint}"/></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="USED" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="UsedCount" Text="0" Style="{StaticResource MetricValue}"/><TextBlock Text="Units recorded as used" Style="{StaticResource Hint}"/></StackPanel></Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="WASTED" Style="{StaticResource Eyebrow}" Foreground="#B85444"/><TextBlock x:Name="WastedCount" Text="0" Style="{StaticResource MetricValue}" Foreground="#B85444"/><TextBlock Text="Units recorded as wasted" Style="{StaticResource Hint}"/></StackPanel></Border>
                    </Grid>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="By food category" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <DataGrid x:Name="CategoryGrid" Grid.Row="1"><DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="2*"/>
                                <DataGridTextColumn Header="In stock" Binding="{Binding InStock}" Width="*"/>
                                <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="*"/>
                                <DataGridTextColumn Header="Wasted" Binding="{Binding Wasted}" Width="*"/>
                            </DataGrid.Columns></DataGrid>
                        </Grid></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="230"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Monthly activity" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="MonthlyGrid" Grid.Row="1"><DataGrid.Columns>
                                    <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="*"/>
                                    <DataGridTextColumn Header="In stock" Binding="{Binding InStock}" Width="*"/>
                                    <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="*"/>
                                    <DataGridTextColumn Header="Wasted" Binding="{Binding Wasted}" Width="*"/>
                                </DataGrid.Columns></DataGrid>
                            </Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Waste by category" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="WasteBars">
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,9"><TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage}" Height="12" Foreground="#D57865" Background="#F3E8E4"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl></ScrollViewer>
                            </Grid></Border>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Simulated waste-risk model" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <Button x:Name="TrainDemoButton" Grid.Column="1" Content="Train demo model" Click="TrainDemoModel_Click"/>
                            </Grid>
                            <TextBlock Text="Demonstration only: predictions learn from generated data, not real household outcomes. The threshold is calibrated on training data."
                                       Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                            <TextBlock x:Name="DemoModelStatus" Text="Not trained. Generate 40,000 training and 10,000 independent test records."
                                       Style="{StaticResource Hint}" Margin="0,5,0,2"/>
                            <TextBlock x:Name="DemoStockStatus" Text="Train the model to score current stock."
                                       Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                            <TextBlock Text="Current stock: expiry status and individual simulated score" Style="{StaticResource SectionTitle}" Margin="0,2,0,4"/>
                            <TextBlock Text="Expiry status comes from dates; the score estimates simulated waste, not the chance of expiry."
                                       Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DemoItemGrid" MinHeight="110" MaxHeight="300" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Food" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                    <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresOn, StringFormat=d}" Width="*"/>
                                    <DataGridTextColumn Header="Days left" Binding="{Binding DaysLeft}" Width="*"/>
                                    <DataGridTextColumn Header="Expiry status" Binding="{Binding Status}" Width="*"/>
                                    <DataGridTextColumn Header="Simulated waste score" Binding="{Binding SimulatedRisk}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Category summary" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DemoRiskGrid" MinHeight="110" MaxHeight="270">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="2*"/>
                                    <DataGridTextColumn Header="In-stock items" Binding="{Binding StockItems}" Width="*"/>
                                    <DataGridTextColumn Header="Average simulated risk" Binding="{Binding AverageRisk}" Width="2*"/>
                                    <DataGridTextColumn Header="Scores above threshold" Binding="{Binding HighRiskItems}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
